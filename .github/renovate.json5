{
  // 중간 심사(11/6) 전까지는 의존성 PR이 쌓이지 않도록 꺼 둔다. 켤 때는 이 줄을 지운다
  // (켜기 전에 main 보호에 CI 통과 필수를 먼저 걸 것: @types 업데이트가 자동 머지된다)
  "enabled": false,

  "extends": ["config:best-practices"], // 글로벌 표준 의존성 관리(Dependency Management) 프리셋 확장

  "timezone": "Asia/Seoul", // 봇의 기준 시간대를 한국으로 설정
  "schedule": ["before 9am on monday"], // 매주 월요일 9시 전에만 묶어서 배달
  "labels": ["dependencies"], // 봇 생성 PR의 자동 생성 라벨

  "packageRules": [
    {
      // 타입 정의 패키지(@types/*)
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["@types/**"],
      "groupName": "definitelyTyped (types)",
      // 타입 정의 업데이트는 서비스 로직에 영향이 없으므로 CI 통과 시 자동 머지
      "automerge": true
    },
    {
      // 프론트엔드 핵심 인프라: React, ESLint, Prettier, Tailwind 관련 작은 업데이트는 PR 1개로 묶음
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "react",
        "react-dom",
        "eslint",
        "eslint-*",
        "@eslint/**",
        "typescript-eslint",
        "prettier",
        "tailwindcss",
        "@tailwindcss/**"
      ],
      "groupName": "core & linting packages"
    }
  ]
}
