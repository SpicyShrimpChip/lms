# backend/.env 예시. 실제 값은 backend/.env(커밋 안 됨)에 넣는다.
# backend/db/setup-local-postgres.sh를 실행하면 .env를 자동으로 만든다 (순서는 docs/setup.md).
# Spring이 .properties 형식으로 읽으므로 값에 \ 가 있으면 \\ 로 적는다.

# 앱 계정 (데이터 읽기·쓰기만)
DB_URL=jdbc:postgresql://localhost:5432/ai_lms
DB_USERNAME=ai_lms_app
DB_PASSWORD=

# 마이그레이션 계정 (Flyway가 테이블을 만들고 바꿀 때만)
DB_MIGRATION_USERNAME=ai_lms_migrator
DB_MIGRATION_PASSWORD=

# Access Token 서명 키 (Base64, 32바이트 이상). 만들기: openssl rand -base64 48
JWT_SECRET=
